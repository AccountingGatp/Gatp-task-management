# ── Supabase (Project Settings → API Keys / Data API) ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) or the legacy "anon public" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Secret key (sb_secret_...) or the legacy "service_role" key. Server only — never expose.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# ── App ───────────────────────────────────────────────────────────
# Full URL of the deployed site (no trailing slash). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated list of email domains allowed to sign in. Leave empty to allow any.
ALLOWED_EMAIL_DOMAINS=gatpsolutions.com
# Time zone used for "today", weeks and due dates
APP_TIMEZONE=Asia/Kolkata

# ── Cron (Vercel sends this as a Bearer token to /api/cron/generate) ──
# Any long random string, e.g. output of: openssl rand -hex 32
CRON_SECRET=change-me-to-a-long-random-string
